{
  "expo": {
    "name": "Duewise",
    "slug": "life-reminder",
    "version": "1.9.3",
    "orientation": "portrait",
    "backgroundColor": "#F3F5FC",
    "icon": "./assets/images/icon.png",
    "scheme": "lifereminder",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.bryan.duewise",
      "backgroundColor": "#F3F5FC",
      "icon": "./assets/images/icon.png",
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "backgroundColor": "#F3F5FC",
      "adaptiveIcon": {
        "backgroundColor": "#3B3468",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bryan.duewise",
      "userInterfaceStyle": "automatic",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3B3468",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 94,
          "dark": {
            "backgroundColor": "#10151D",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-system-ui",
      [
        "expo-notifications",
        {
          "color": "#3B3468",
          "defaultChannel": "duewise-reminders"
        }
      ],
      "./plugins/with-private-backups",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "DuewiseUpcoming",
              "label": "Duewise",
              "description": "Upcoming reminders and overdue count",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen|not_keyguard",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.bryan.duewise.widgets",
          "groupIdentifier": "group.com.bryan.duewise",
          "widgets": [
            {
              "name": "DuewiseUpcoming",
              "displayName": "Duewise",
              "description": "Upcoming reminders and overdue count",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ]
              }
            }
          ]
        }
      ],
      [
        "expo-calendar",
        {
          "writeOnlyAccess": true,
          "calendarPermission": "Allow Duewise to add the reminders you choose to your calendar.",
          "writeOnlyCalendarPermission": "Allow Duewise to add the reminders you choose to your calendar.",
          "remindersPermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "73487ec1-5685-4b6c-a7d2-0e6e972f98cf"
      }
    }
  }
}
